@model IEnumerable<UserManagementSystem.Models.User>

@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
    Layout = "_AdminLayout";
    var allUsers = (List<UserManagementSystem.Models.User>)ViewBag.AllUsers;
}

<!-- İstatistik Kartları -->
<div class="row mb-3 justify-content-center g-2">
    <div class="col-12 col-sm-6 col-md-3">
        <div class="card text-center shadow-sm border-0 h-100">
            <div class="card-body p-2 d-flex flex-column justify-content-center">
                <h6 class="mb-1">Toplam Kullanıcı</h6>
                <h4 class="mb-0">@allUsers.Count()</h4>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-md-3">
        <div class="card text-center shadow-sm border-0 h-100">
            <div class="card-body p-2 d-flex flex-column justify-content-center">
                <h6 class="mb-1">Aktif Kullanıcı</h6>
                <h4 class="mb-0 text-success">@allUsers.Count(u => u.IsActive)</h4>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-md-3">
        <div class="card text-center shadow-sm border-0 h-100">
            <div class="card-body p-2 d-flex flex-column justify-content-center">
                <h6 class="mb-1">Pasif Kullanıcı</h6>
                <h4 class="mb-0 text-danger">@allUsers.Count(u => !u.IsActive)</h4>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-md-3">
        <div class="card text-center shadow-sm border-0 h-100">
            <div class="card-body p-2 d-flex flex-column justify-content-center">
                <h6 class="mb-1">Son Eklenen</h6>
                @if (ViewBag.LastAddedUser != null)
                {
                    <div class="fw-semibold" style="font-size: 0.95rem; color: var(--brand-blue-hover);">
                        <i class="bi bi-person-plus-fill me-1"></i> @ViewBag.LastAddedUser.Name @ViewBag.LastAddedUser.Surname
                    </div>
                    <small class="text-muted" style="font-size: 0.75rem">@ViewBag.LastAddedUser.CreatedAt.ToString("dd.MM.yyyy")</small>
                }
                else
                {
                    <small class="text-muted">Henüz kullanıcı yok</small>
                }
            </div>
        </div>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<!-- Başlık -->
<div class="mb-4 d-flex">
    <h2>Kullanıcı Yönetim Sistemi</h2>
    <button type="button" class="btn btn-brand btn-sm rounded-pill px-3 ms-auto" data-bs-toggle="modal"
            data-bs-target="#createUserModal">
        <i class="bi bi-plus-lg me-1"></i>Yeni Kullanıcı
    </button>
</div>

<div class="d-flex gap-2 mb-3">
    <select id="departmentFilter" class="form-select form-select-sm" style="width:auto;">
        <option value="">Tüm Departmanlar</option>
        @foreach (var d in (IEnumerable<UserManagementSystem.Models.Department>)ViewBag.Departments)
        {
            <option value="@d.Name">@d.Name</option>
        }
    </select>
 
    <select id="statusFilter" class="form-select form-select-sm" style="width:auto;">
        <option value="">Tüm Durumlar</option>
        <option value="Aktif">Aktif</option>
        <option value="Pasif">Pasif</option>
    </select>
</div>


<!-- Tablo -->
<div class="card shadow-sm">
    <div class="card-body p-2 p-md-2 overflow-auto">
        <table class="table table-hover table-striped align-middle" id="usersTable" style="font-size: 0.85rem;">
            <thead class="table-navy sticky-top">
                <tr>
                    <th style="min-width: 60px;"> Ad</th>
                    <th style="min-width: 60px;">Soyad</th>
                    <th style="min-width: 120px;">E-Posta</th>
                    <th style="min-width: 90px;">Departman</th>
                    <th style="min-width: 85px;">Katılım Tarihi</th>
                    <th style="min-width: 60px;">Durum</th>
                    <th style="min-width: 70px;">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrEmpty(user.ProfilePhotoPath))
                                {
                                    <img src="~/uploads/profiles/@user.ProfilePhotoPath" class="rounded-circle" width="36" height="36" style="object-fit:cover;" />
                                }
                                else
                                {
                                    <i class="bi bi-person-circle fs-4 text-secondary"></i>
                                }
                                <span>@user.Name</span>
                            </div>
                        </td>
                        <td>@user.Surname</td>
                        <td>@user.Email</td>
                        <td>@user.Department?.Name</td>
                        <td>@user.CreatedAt.ToString("dd.MM.yyyy")</td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="badge badge-active">Aktif</span>
                            }
                            else
                            {
                                <span class="badge badge-passive">Pasif</span>
                            }
                        </td>
                        <td>
                            <button class="btn btn-link p-1" data-bs-toggle="modal" data-bs-target="#viewUserModal-@user.Id"
                                    title="Görüntüle">
                                <i class="bi bi-eye text-secondary fs-6"></i>
                            </button>

                            <button class="btn btn-link p-1" data-bs-toggle="modal" data-bs-target="#editUserModal-@user.Id"
                                    title="Düzenle">
                                <i class="bi bi-pencil text-secondary fs-6"></i>
                            </button>

                            <form asp-action="Delete" asp-controller="Users" method="post" class="d-inline"
                                  onsubmit="return confirm('Bu kullanıcıyı kalıcı olarak silmek istediğinize emin misiniz?');">
                                <input type="hidden" name="id" value="@user.Id" />
                                <button type="submit" class="btn btn-link p-1" title="Sil">
                                    <i class="bi bi-trash text-danger fs-6"></i>
                                </button>
                            </form>
                        </td>
                    </tr>

                    <div class="modal fade" id="editUserModal-@user.Id" tabindex="-1">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">Kullanıcıyı Düzenle</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <form asp-action="Edit" asp-controller="Users" method="post">
                                    <input type="hidden" name="Id" value="@user.Id" />
                                    <div class="modal-body">
                                        @if (!string.IsNullOrEmpty(user.ProfilePhotoPath))
                                        {
                                            <img src="~/uploads/profiles/@user.ProfilePhotoPath" class="rounded-circle mb-2" width="60" height="60" style="object-fit:cover;" />
                                        }
                                        <div class="mb-3">
                                            <label>Profil Fotoğrafı (değiştirmek için seç)</label>
                                            <input type="file" class="form-control" name="ProfilePhoto" accept="image/*" />
                                        </div>
                                        <div class="mb-3">
                                            <label>Ad</label>
                                            <input class="form-control" name="Name" value="@user.Name" />
                                        </div>
                                        <div class="mb-3">
                                            <label>Soyad</label>
                                            <input class="form-control" name="Surname" value="@user.Surname" />
                                        </div>
                                        <div class="mb-3">
                                            <label>E-Posta</label>
                                            <input class="form-control" name="Email" value="@user.Email" />
                                        </div>
                                        <div class="mb-3">
                                            <label>Departman</label>
                                            <select class="form-select" name="DepartmentId"
                                                    id="editDepartmentSelect-@user.Id">
                                                <option value="">Seçiniz</option>
                                                @foreach (var d
                                            in
                                            (IEnumerable<UserManagementSystem.Models.Department>)ViewBag.Departments)
                                                {
                                                    <option value="@d.Id" selected="@(d.Id == user.DepartmentId)">
                                                        @d.Name</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="mb-3">
                                                <label>Yönetici</label>
                                                <select class="form-select" name="ManagerId" id="editManagerSelect-@user.Id">
                                                    <option value="">Yok</option>
                                                    @foreach (var m in allUsers.Where(x => x.IsManager && x.Id != user.Id))
                                                    {
                                                        <option value="@m.Id" selected="@(m.Id == user.ManagerId)">@m.Name
                                                            @m.Surname</option>
                                                        }
                                                    </select>
                                                </div>

                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" name="IsManager" value="true"
                                                           checked="@user.IsManager" />
                                                    <label class="form-check-label">Yönetici</label>
                                                </div>

                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" name="IsActive" value="true"
                                                           checked="@user.IsActive" />
                                                    <label class="form-check-label">Aktif Kullanıcı</label>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary"
                                                        data-bs-dismiss="modal">Kapat</button>
                                                <button type="submit" class="btn btn-primary">Güncelle</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>

                            <div class="modal fade" id="viewUserModal-@user.Id" tabindex="-1">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title">Kullanıcı Detayı</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body">
                                            <p><strong>Ad:</strong> @user.Name</p>
                                            <p><strong>Soyad:</strong> @user.Surname</p>
                                            <p><strong>E-Posta:</strong> @user.Email</p>
                                            <p><strong>Departman:</strong> @user.Department?.Name</p>
                                            <p><strong>Katılım Tarihi:</strong> @user.CreatedAt.ToString("dd.MM.yyyy")</p>
                                            <p><strong>Yönetici:</strong> @(user.Manager != null ? $"{user.Manager.Name}                                            {user.Manager.Surname}" : "-")</p>
                                            <p>
                                                <strong>Durum:</strong>
                                                @if (user.IsActive)
                                                {
                                                    <span class="badge badge-active">Aktif</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-passive">Pasif</span>
                                                }
                                            </p>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

        <!-- Yeni Kullanıcı Modalı -->
        <div class="modal fade" id="createUserModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Yeni Kullanıcı</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <form asp-action="Create" asp-controller="Users" method="post">
                        <div class="modal-body">
                            <div class="mb-3">
                                <label>Profil Fotoğrafı</label>
                                <input type="file" class="form-control" name="ProfilePhoto" accept="image/*" />
                            </div>
                            <div class="mb-3">
                                <label>Ad</label>
                                <input class="form-control" name="Name" />
                            </div>
                            <div class="mb-3">
                                <label>Soyad</label>
                                <input class="form-control" name="Surname" />
                            </div>
                            <div class="mb-3">
                                <label>E-Posta</label>
                                <input class="form-control" name="Email" />
                            </div>
                            <div class="mb-3">
                                <label>Departman</label>
                                <select class="form-select" name="DepartmentId" id="createDepartmentSelect">
                                    <option value="">Seçiniz</option>
                                    @foreach (var d in
                                    (IEnumerable<UserManagementSystem.Models.Department>)ViewBag.Departments)
                                    {
                                        <option value="@d.Id">@d.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label>Yönetici</label>
                                <select class="form-select" name="ManagerId" id="createManagerSelect">
                                    <option value="">Yok</option>
                                    @foreach (var m in allUsers.Where(x => x.IsManager))
                                    {
                                        <option value="@m.Id">@m.Name @m.Surname</option>
                                    }
                                </select>
                            </div>

                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="IsManager" value="true" />
                                <label class="form-check-label">Yönetici</label>
                            </div>

                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="IsActive" value="true" checked />
                                <label class="form-check-label">Aktif Kullanıcı</label>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                            <button type="submit" class="btn btn-primary">Kaydet</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        @section Scripts {
            <script>
                // Departman filtresi -> Departman kolonu (index 3: Ad,Soyad,Email,Departman,...)
                $('#departmentFilter').on('change', function () {
                    if ($.fn.DataTable.isDataTable('#usersTable')) {
                        $('#usersTable').DataTable().column(3).search(this.value).draw();
                    }
                });

                // Durum filtresi -> Durum kolonu (index 5)
                $('#statusFilter').on('change', function () {
                    if ($.fn.DataTable.isDataTable('#usersTable')) {
                        $('#usersTable').DataTable().column(5).search(this.value).draw();
                    }
                });

                // Departman -> Yönetici Id eşleşmesi
                const departmentManagerMap = {
                        @foreach (var d in (IEnumerable<UserManagementSystem.Models.Department>)ViewBag.Departments)
                    {
                                @Html.Raw($"{d.Id}: {(d.ManagerId.HasValue ? d.ManagerId.ToString() : "null")},")
                    }
                    };

                function setupAutoManager(departmentSelectId, managerSelectId) {
                    const deptSelect = document.getElementById(departmentSelectId);
                    const managerSelect = document.getElementById(managerSelectId);

                    if (!deptSelect || !managerSelect) return;

                    deptSelect.addEventListener('change', function () {
                        const deptId = this.value;
                        const managerId = departmentManagerMap[deptId];

                        if (managerId) {
                            managerSelect.value = managerId;
                        }
                    });
                }

                // Create modalindeki dropdown'lar için
                setupAutoManager('createDepartmentSelect', 'createManagerSelect');

                // Her Edit modali için
                document.querySelectorAll('[id^="editDepartmentSelect-"]').forEach(function (deptSelect) {
                    const userId = deptSelect.id.split('-')[1];
                    setupAutoManager('editDepartmentSelect-' + userId, 'editManagerSelect-' + userId);
                });
            </script>
        }