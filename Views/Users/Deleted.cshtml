@model IEnumerable<UserManagementSystem.Models.User>
 
@{
    ViewData["Title"] = "Silinen Kullanıcılar";
    Layout = "_AdminLayout";
}
 
@if (TempData["SuccessMessage"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            Swal.fire({
                icon: 'success',
                title: 'Başarılı!',
                text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["SuccessMessage"])),
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true
            });
        });
    </script>
}

<div class="mb-4">
    <h2>Silinen Kullanıcılar</h2>
</div>
 
<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover table-striped align-middle">
            <thead class="table-navy">
                <tr>
                    <th>Ad</th>
                    <th>Soyad</th>
                    <th>E-Posta</th>
                    <th>Departman</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">Silinen kullanıcı yok</td>
                    </tr>
                }
                @foreach (var user in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrEmpty(user.ProfilePhotoPath))
                                {
                                    <img src="~/uploads/profiles/@user.ProfilePhotoPath" class="rounded-circle" width="36" height="36" style="object-fit:cover;" />
                                }
                                else
                                {
                                    <i class="bi bi-person-circle fs-4 text-secondary"></i>
                                }
                                <span>@user.Name</span>
                            </div>
                        </td>
                        <td>@user.Surname</td>
                        <td>@user.Email</td>
                        <td>@user.Department?.Name</td>
                        <td>
                            <form asp-action="Restore" asp-controller="Users" method="post" class="d-inline restore-form">
                                <input type="hidden" name="id" value="@user.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-success">
                                    <i class="bi bi-arrow-counterclockwise me-1"></i>Geri Getir
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('submit', function (e) {
            const form = e.target;
            if (form.classList.contains('restore-form')) {
                e.preventDefault();

                Swal.fire({
                    icon: 'question',
                    title: 'Emin misiniz?',
                    text: 'Bu kullanıcı geri getirilecek.',
                    showCancelButton: true,
                    confirmButtonText: 'Evet, geri getir',
                    cancelButtonText: 'Vazgeç',
                    confirmButtonColor: '#004e9e',
                    cancelButtonColor: '#e3000f'
                }).then((result) => {
                    if (result.isConfirmed) {
                        form.submit();
                    }
                });
            }
        });
    </script>
}
 