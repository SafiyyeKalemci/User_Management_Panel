<!DOCTYPE html>

<html lang="tr">

<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.colvis.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" />
    

</head>

<body>

    <div class="admin-layout">

        <!-- Sol Menü -->
        <aside id="sidebar" class="sidebar-custom text-white p-3">

            <div class="sidebar-header">
                <h4 class="sidebar-title mb-0">Admin Panel</h4>
                <button id="sidebarToggle" class="sidebar-toggle-btn" type="button" aria-label="Menüyü kapat">
                    <i class="bi bi-chevron-left"></i>
                </button>
            </div>

            <ul class="nav flex-column">

                <li class="nav-item mb-2">
                    <a class="nav-link-custom" href="/Users" data-label="Kullanıcılar" title="Kullanıcılar">
                        <i class="bi bi-people me-2"></i>
                        Kullanıcılar
                    </a>
                </li>

                <li class="nav-item mb-2">
                    <a class="nav-link-custom" href="/Departments" data-label="Departmanlar" title="Departmanlar">
                        <i class="bi bi-building me-2"></i>
                        Departmanlar
                    </a>
                </li>

                <li class="nav-item mb-2">
                    <a class="nav-link-custom" href="/Reports" data-label="Raporlar" title="Raporlar">
                        <i class="bi bi-bar-chart me-2"></i>
                        Raporlar
                    </a>
                </li>

                <li class="nav-item mb-2">
                    <a class="nav-link-custom" href="/Users/Deleted" data-label="Silinenler" title="Silinenler">
                        <i class="bi bi-trash3 me-2"></i>
                        Silinenler
                    </a>
                </li>
            </ul>
        </aside>

        <!-- Sağ Taraf / Ana İçerik -->
        <div id="mainContent" class="main-content">
            @RenderBody()
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.colVis.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

    <script>

        const sidebar = document.getElementById("sidebar");
        const mainContent = document.getElementById("mainContent");
        const sidebarToggle = document.getElementById("sidebarToggle");

        // Tüm kütüphaneler yüklene kadar bekle
        document.addEventListener('DOMContentLoaded', function() {
            // DataTable'ı sadece usersTable varsa başlat
            if (document.getElementById('usersTable')) {
                const table = $('#usersTable').DataTable({
                    pageLength: 10,
                    lengthMenu: [5, 10, 25, 50],
                    dom: 'Bfrtip',
                    buttons: [
                        { extend: 'excelHtml5', text: 'Excel', className: 'btn btn-sm btn-success' },
                        { extend: 'csvHtml5', text: 'CSV', className: 'btn btn-sm btn-info' }
                    ],
                    language: {
                        search: "Ara:",
                        lengthMenu: "Sayfa başına _MENU_ kayıt",
                        info: "_START_ - _END_ / toplam _TOTAL_ kayıt",
                        paginate: { previous: "Önceki", next: "Sonraki" },
                        zeroRecords: "Kayıt bulunamadı"
                    }
                });
            }
        });

        // Responsive - Mobil ekranda sidebar otomatik daralmış olsun
        function handleResponsive() {
            const isMobile = window.innerWidth <= 575.98;

            if (isMobile) {
                sidebar.classList.add("sidebar-collapsed");
                mainContent.classList.add("main-content-expanded");
                const icon = sidebarToggle.querySelector("i");
                icon.classList.remove("bi-chevron-left");
                icon.classList.add("bi-chevron-right");
            } else {
                sidebar.classList.remove("sidebar-collapsed");
                mainContent.classList.remove("main-content-expanded");
                const icon = sidebarToggle.querySelector("i");
                icon.classList.remove("bi-chevron-right");
                icon.classList.add("bi-chevron-left");
            }
        }

        // Başlangıçta responsive kontrol et
        handleResponsive();

        // Pencere resize olduğunda kontrol et
        window.addEventListener("resize", handleResponsive);

        // Toggle butonuna tıklandığında
        sidebarToggle.addEventListener("click", function () {

            // Eğer mobil değilse toggle et
            if (window.innerWidth > 575.98) {
                sidebar.classList.toggle("sidebar-collapsed");
                mainContent.classList.toggle("main-content-expanded");

                const icon = sidebarToggle.querySelector("i");

                if (sidebar.classList.contains("sidebar-collapsed")) {
                    icon.classList.remove("bi-chevron-left");
                    icon.classList.add("bi-chevron-right");
                    sidebarToggle.setAttribute("aria-label", "Menüyü aç");
                } else {
                    icon.classList.remove("bi-chevron-right");
                    icon.classList.add("bi-chevron-left");
                    sidebarToggle.setAttribute("aria-label", "Menüyü kapat");
                }
            }
        });

    </script>

    @RenderSection("Scripts", required: false)

</body>

</html>
