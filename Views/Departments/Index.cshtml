@model IEnumerable<UserManagementSystem.Models.Department>

@{
    ViewData["Title"] = "Departman Yönetimi";
    Layout = "_AdminLayout";
}


@if (TempData["ErrorMessage"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            Swal.fire({
                icon: 'error',
                title: 'Hata!',
                text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ErrorMessage"])),
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 4000,
                timerProgressBar: true
            });
        });
    </script>
}

<div class="mb-4">
    <h2>Departman Yönetimi</h2>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover table-striped align-middle">
            <thead class="table-navy">
                <tr>
                    <th>Departman Adı</th>
                    <th>Yönetici</th>
                    <th class="text-center">Çalışan Sayısı</th>
                    <th class="text-center">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var dept in Model)
                {
                    <tr>
                        <td>@dept.Name</td>
                        <td>@(dept.Manager != null ? $"{dept.Manager.Name} {dept.Manager.Surname}" : "-")</td>
                        <td class="text-center">@(dept.Users?.Count ?? 0)</td>
                        <td class="text-center">
                            <button class="btn btn-link p-1" data-bs-toggle="modal" data-bs-target="#editDepartmentModal-@dept.Id"
                                    title="Düzenle">
                                <i class="bi bi-pencil text-secondary fs-6"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>


<!-- Düzenleme Modalleri -->
@foreach (var dept in Model)
{
    <div class="modal fade" id="editDepartmentModal-@dept.Id" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Departmanı Düzenle</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form asp-action="Edit" asp-controller="Departments" method="post">
                    <input type="hidden" name="Id" value="@dept.Id" />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label>Departman Adı</label>
                            <input class="form-control" name="Name" value="@dept.Name" />
                        </div>
                        <div class="mb-3">
                            <label>Yönetici</label>
                            <select class="form-select" name="ManagerId">
                                <option value="">Yok</option>
                                @foreach (var m in (IEnumerable<UserManagementSystem.Models.User>)ViewBag.Managers)
                                {
                                    <option value="@m.Id" selected="@(m.Id == dept.ManagerId)">@m.Name @m.Surname</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                        <button type="submit" class="btn btn-primary">Güncelle</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}